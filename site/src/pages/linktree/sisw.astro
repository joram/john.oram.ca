---
const links = [
  {
    href: 'https://www.linkedin.com/in/john-oram',
    label: 'LinkedIn',
    hint: 'linkedin.com/in/john-oram',
    external: true,
  },
  {
    href: 'mailto:john@veilstream.com',
    label: 'Work email',
    hint: 'john@veilstream.com',
  },
  {
    href: 'mailto:john@oram.ca',
    label: 'Personal email',
    hint: 'john@oram.ca',
  },
  {
    href: 'https://console.veilstream.com',
    label: 'console.veilstream.com',
    hint: 'Free, under $20',
    external: true,
    primary: true,
  },
  {
    href: 'https://www.veilstream.com',
    label: 'www.veilstream.com',
    hint: 'Landing page',
    external: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>John Oram — Self-Improving Software</title>
    <meta
      name="description"
      content="John Oram. LinkedIn, email, and VeilStream — follow-up from Self-Improving Software."
    />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content="John Oram — Self-Improving Software" />
    <meta
      property="og:description"
      content="LinkedIn, email, and VeilStream."
    />
    <meta property="og:image" content="/static/profile.jpg" />
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <img src="/static/profile.jpg" alt="John Oram" class="photo" />
        <p class="eyebrow">SISW</p>
        <h1>John Oram</h1>
        <p class="lede">Self-improving software</p>
      </header>

      <nav class="stack" aria-label="Links">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['card', link.primary && 'card-primary']}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="card-copy">
              <span class="card-label">{link.label}</span>
              <span class="card-hint">{link.hint}</span>
            </span>
            <span class="card-go" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>

      <p class="foot">
        <a href="/opinion/self_improving_software_memory">Read the essay</a>
        <span aria-hidden="true">·</span>
        <a href="/">john.oram.ca</a>
      </p>
    </main>
  </body>
</html>

<style>
  :root {
    --void: #161718;
    --paper: #1c1d1e;
    --slab: #262728;
    --bone: #ece8e1;
    --dim: rgba(236, 232, 225, 0.55);
    --line: rgba(236, 232, 225, 0.12);
    --amber: #e8a04a;
    --ink: #161718;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--void);
    color: var(--bone);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .page {
    min-height: 100dvh;
    max-width: 22.5rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .photo {
    display: block;
    width: 6.25rem;
    height: 6.25rem;
    margin: 0 auto 1.15rem;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--amber);
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
  }

  h1 {
    margin: 0;
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .lede {
    margin: 0.4rem 0 0;
    color: var(--dim);
    font-size: 0.95rem;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem 0.9rem 1.05rem;
    background: var(--slab);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
    min-height: 3.35rem;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: rgba(232, 160, 74, 0.45);
    background: #2c2d2e;
  }

  .card:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }

  .card-primary {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--ink);
  }

  .card-primary:hover {
    background: #f0b05c;
    border-color: #f0b05c;
  }

  .card-primary .card-hint,
  .card-primary .card-go {
    color: rgba(22, 23, 24, 0.62);
  }

  .card-copy {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .card-label {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .card-hint {
    font-size: 0.75rem;
    color: var(--dim);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-go {
    flex-shrink: 0;
    color: var(--dim);
    font-size: 0.95rem;
  }

  .foot {
    margin: 1.75rem 0 0;
    text-align: center;
    font-size: 0.78rem;
    color: var(--dim);
  }

  .foot a {
    color: var(--dim);
    text-decoration: none;
  }

  .foot a:hover,
  .foot a:focus-visible {
    color: var(--bone);
  }

</style>
